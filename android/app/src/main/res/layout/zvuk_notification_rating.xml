<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="8dp" android:background="#202028">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/zvuk_notification_art" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop" android:src="@drawable/ic_stat_music" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/zvuk_notification_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/zvuk_notification_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBBCC8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center">
        <ImageButton android:id="@+id/zvuk_notification_previous" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/audio_service_skip_previous" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Предыдущая" />
        <ImageButton android:id="@+id/zvuk_notification_play" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/audio_service_play_arrow" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Слушать" />
        <ImageButton android:id="@+id/zvuk_notification_next" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/audio_service_skip_next" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Следующая" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center">
        <ImageButton android:id="@+id/zvuk_notification_minus" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_rating_minus" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Минус 1 балл" />
        <TextView android:id="@+id/zvuk_notification_score" android:layout_width="wrap_content" android:minWidth="52dp" android:layout_height="48dp" android:paddingHorizontal="8dp" android:gravity="center" android:textSize="20sp" android:textStyle="bold" android:textColor="#CDFA74" />
        <ImageButton android:id="@+id/zvuk_notification_plus" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_rating_plus" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Плюс 1 балл" />
    </LinearLayout>
</LinearLayout>
