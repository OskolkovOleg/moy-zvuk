<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="4dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:background="#202028">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/zvuk_notification_art" android:layout_width="36dp" android:layout_height="36dp" android:scaleType="centerCrop" android:src="@drawable/ic_stat_music" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:id="@+id/zvuk_notification_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/zvuk_notification_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBBCC8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/zvuk_notification_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/audio_service_skip_previous" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Предыдущая" />
        <ImageButton android:id="@+id/zvuk_notification_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/audio_service_play_arrow" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Слушать" />
        <ImageButton android:id="@+id/zvuk_notification_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/audio_service_skip_next" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Следующая" />
        <ImageButton android:id="@+id/zvuk_notification_minus" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_height="48dp" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/ic_rating_minus" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Минус 1 балл" />
        <TextView android:id="@+id/zvuk_notification_score" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:textSize="18sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" android:maxLines="1" android:textColor="#CDFA74" />
        <ImageButton android:id="@+id/zvuk_notification_plus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/ic_rating_plus" android:tint="#FFFFFF" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Плюс 1 балл" />
    </LinearLayout>
</LinearLayout>
